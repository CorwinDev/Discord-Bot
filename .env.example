DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
CASH_PRIZE_APPROVER_IDS=

# ---------------------------------------------------------------
# KHÔNG BẮT BUỘC dùng file .env. Có thể đặt các biến này trực tiếp
# ở nơi chạy bot (Secrets/Variables của hosting, docker -e ...).
# Các biến dưới đây đều tuỳ chọn:
# ---------------------------------------------------------------
# Webhook Discord nhận thông báo lỗi/ngắt kết nối (Cài đặt kênh -> Tích hợp -> Webhook)
ERROR_WEBHOOK_URL=
# ID người dùng được ping khi sự cố nghiêm trọng
ALERT_MENTION_USER_ID=
# Mật khẩu xem web trạng thái (để trống = trang công khai, chỉ hiện thông tin tổng quát)
DASHBOARD_TOKEN=
# Cổng web trạng thái (hosting thường tự đặt PORT)
PORT=3000
# Báo cáo tình hình qua webhook: mỗi bao nhiêu phút (1-60, mặc định 5)
REPORT_INTERVAL_MINUTES=5
# Tự bật lại bot khi tiến trình sập (mặc định bật; đặt false nếu đã dùng Docker restart / PM2)
# AUTO_SUPERVISE=true
# Tự đăng ký slash command lên Discord khi danh sách lệnh thay đổi (mặc định bật)
# AUTO_DEPLOY_COMMANDS=true
# AUTO_FIX=true  RECOVERY_GRACE_SECONDS=120  RECOVERY_MAX_ATTEMPTS=5  MAX_MEMORY_MB=0
# DASHBOARD_ENABLED=true  CAPTURE_CONSOLE_ERRORS=true  HIGH_PING_MS=1500