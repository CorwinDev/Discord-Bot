{
  "name": "discord-bot",
  "version": "1.3.0",
  "description": "Bot Discord đa chức năng: quản trị, chào mừng, tiện ích, nhạc, level",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "start:safe": "node src/supervisor.js",
    "webhook:test": "node src/monitor/webhookNotifier.js",
    "deploy": "node src/deploy-commands.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "backup:list": "node src/monitor/backup.js",
    "backup:now": "node src/monitor/backup.js --now"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
